# Install in /etc/nginx/conf.d/trustledger.conf; replace DEMO_HOST first.
limit_req_zone $binary_remote_addr zone=tl_api:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=tl_login:10m rate=6r/m;
limit_conn_zone $binary_remote_addr zone=tl_connections:10m;
server {
    listen 80;
    server_name DEMO_HOST;
    return 301 https://DEMO_HOST$request_uri;
}
server {
    listen 443 ssl;
    server_name DEMO_HOST;
    ssl_certificate /etc/letsencrypt/live/DEMO_HOST/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DEMO_HOST/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /opt/trustledger/current/frontend/dist;
    index index.html;
    server_tokens off;
    access_log off;
    error_log /var/log/nginx/trustledger-error.log crit;
    auth_basic "TrustLedger evaluator demo";
    auth_basic_user_file /etc/trustledger/evaluators.htpasswd;
    client_max_body_size 16k;
    limit_conn tl_connections 20;
    limit_req_status 429;
    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Cache-Control no-store always;
    location ~ /\. { return 404; }
    # Preserve the application's local-only administration boundary.
    location ~ ^/api/v1/(admin|data-sources)(/|$) { deny all; }
    location ~ ^/(docs|redoc|openapi.json)(/|$) { deny all; }
    location = /api/v1/auth/login {
        limit_req zone=tl_login burst=4 nodelay;
        include /etc/nginx/trustledger-proxy.conf;
    }
    location /api/ {
        limit_req zone=tl_api burst=15 nodelay;
        include /etc/nginx/trustledger-proxy.conf;
    }
    location = /health {
        limit_req zone=tl_api burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000/api/v1/health;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization "";
    }
    location / { try_files $uri $uri/ /index.html; }
}
