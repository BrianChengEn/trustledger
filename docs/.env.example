# Copy to backend/.env or the repo location expected by backend settings.
# NEVER place real keys in this example, Git, frontend files, chat, screenshots, or logs.

APP_ENV=development
APP_MODE=synthetic
DEMO_USER_ID=demo-user-001
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
ALLOW_MEMORY_WRITE=false

# Capital One Nessie sandbox. Confirm current base URL and allowed endpoints in the
# official event documentation before switching APP_MODE=live.
NESSIE_BASE_URL=https://prod-api.nessieisreal.com
NESSIE_API_KEY=
NESSIE_TIMEOUT_SECONDS=5

# Jev: backend only.
JEV_BASE_URL=https://jev-ai.org/api/v1
JEV_API_KEY=
JEV_MODEL=jev-1.13
JEV_TIMEOUT_SECONDS=5

# Backboard: backend only.
BACKBOARD_BASE_URL=https://app.backboard.io/api
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=
BACKBOARD_TIMEOUT_SECONDS=8

# Gemini explanation: backend only. Empty keeps the rules explanation and makes no call.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Local-only demo persistence. Do not point this at real financial data.
DATABASE_URL=sqlite:///./trustledger-demo.db

