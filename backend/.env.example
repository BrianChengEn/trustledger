# Server-side only. Never commit backend/.env. Normal runtime reads the Nessie sandbox API.
APP_ENV=development
# Live reads require a key and sandbox customer selection (or an existing confirmed mapping).
TRANSACTION_PROVIDER=nessie
# Optional offline generated Nessie user history: use the dedicated account-demo launcher (README).
# DEMO_ACCOUNT_TOKEN=acct_<32 lowercase hex characters>
# Explicit opt-in: backboard-jev requires BACKBOARD_API_KEY; mock-jev stays offline.
FRAUD_PROVIDER=rules-only
ALLOW_MEMORY_WRITE=false
DEMO_USER_ID=demo-user-001
FRONTEND_ORIGIN=http://localhost:5173
NESSIE_API_KEY=
NESSIE_CUSTOMER_ID=
JEV_API_KEY=
BACKBOARD_API_KEY=
# Optional explanation provider. Leave empty to use rules text and make no Gemini call.
# Never put this key in a VITE_ variable or in frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Demo sign-in (a demo gate for localhost, NOT production authentication).
# REQUIRE_LOGIN=true makes every data route need a session. An empty DEMO_USER_PASSCODE leaves user sign-in open.
# An empty DEMO_ADMIN_PASSCODE disables admin sign-in entirely. An empty SESSION_SECRET means a random secret per server
# start (everyone is signed out when the server restarts). Keep real values in backend/.env only, never in Git.
REQUIRE_LOGIN=false
DEMO_USER_PASSCODE=
DEMO_ADMIN_PASSCODE=
SESSION_SECRET=
# Lets a signed-in admin add, edit, delete and reset the synthetic demo transactions. Off unless set to true.
ALLOW_DEMO_EDIT=false
