# Server-side only. Never commit backend/.env. This starter stays synthetic.
APP_ENV=development
# Opt in with an existing confirmed synthetic Nessie baseline mapping; key alone stays synthetic.
TRANSACTION_PROVIDER=synthetic
# Explicit opt-in: backboard-jev requires BACKBOARD_API_KEY; mock-jev stays offline.
FRAUD_PROVIDER=rules-only
ALLOW_MEMORY_WRITE=false
DEMO_USER_ID=demo-user-001
FRONTEND_ORIGIN=http://127.0.0.1:5176
# dev-backend.sh enforces sign-in; direct API tooling retains its legacy opt-in behavior.
REQUIRE_LOGIN=true
# Local synthetic demo only: both roles accept blank input by default.
DEMO_USER_PASSCODE=
DEMO_ADMIN_PASSCODE=
# Empty generates a new signing secret at startup; never commit a real secret.
SESSION_SECRET=
NESSIE_API_KEY=
JEV_API_KEY=
BACKBOARD_API_KEY=
